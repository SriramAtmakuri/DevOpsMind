{
  "name": "devopsmind",
  "version": "1.0.0",
  "description": "AI-powered DevOps Command Center with MCP integration",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "setup": "npm install && cd client && npm install"
  },
  "keywords": [
    "devops",
    "ai",
    "mcp",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.2",
    "node-ssh": "^13.1.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "simple-git": "^3.20.0",
    "socket.io": "^4.6.2",
    "systeminformation": "^5.21.7",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
